{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afterstep",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "afterstep.brightloopapps.com", "custom_domain": true }]
}
