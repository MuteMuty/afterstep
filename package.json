{
  "name": "afterstep",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "sh scripts/build-wasm.sh",
    "levels": "node scripts/build-levels.ts",
    "dev": "npm run wasm && npm run levels && vite web",
    "build": "npm run wasm && npm run levels && tsc -p web && vite build web && node scripts/build-headers.ts",
    "check-headers": "node scripts/check-headers.ts",
    "preview": "vite preview web",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p web && tsc -p . && tsc -p tests",
    "playtest": "node tests/playtest.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.52.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "wrangler": "4.160.0"
  }
}
